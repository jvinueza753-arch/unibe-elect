generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Rol {
  ESTUDIANTE
  ADMINISTRADOR
}
enum Estado {
  ACTIVO
  INACTIVO
}
enum EstadoSolicitudRecuperacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  COMPLETADA
  EXPIRADA
}
model Usuario {
  id String @id @default(uuid()) @db.Uuid
  nombres String
  apellidos String
  correo String @unique
  contrasenaHash String
  codigoEstudiantil String @unique
  facultad String
  carrera String
  rol Rol @default(ESTUDIANTE)
  estado Estado @default(ACTIVO)
  sessionVersion Int @default(0)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  solicitudesRecuperacion SolicitudRecuperacion[]
  solicitudesAprobadas SolicitudRecuperacion[] @relation("SolicitudRecuperacionAprobador")
  solicitudesRechazadas SolicitudRecuperacion[] @relation("SolicitudRecuperacionRechazador")
  solicitudesReemitidas SolicitudRecuperacion[] @relation("SolicitudRecuperacionReemisor")
  @@index([facultad, carrera])
  @@map("usuarios")
}
model SolicitudRecuperacion {
  id String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid
  estado EstadoSolicitudRecuperacion @default(PENDIENTE)
  codigoHash String? @unique
  codigoExpira DateTime?
  solicitadaEn DateTime @default(now())
  resueltaEn DateTime?
  aprobadaPorId String? @db.Uuid
  aprobadaEn DateTime?
  rechazadaPorId String? @db.Uuid
  rechazadaEn DateTime?
  reemitidaPorId String? @db.Uuid
  reemitidaEn DateTime?
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aprobadaPor Usuario? @relation("SolicitudRecuperacionAprobador", fields: [aprobadaPorId], references: [id], onDelete: SetNull)
  rechazadaPor Usuario? @relation("SolicitudRecuperacionRechazador", fields: [rechazadaPorId], references: [id], onDelete: SetNull)
  reemitidaPor Usuario? @relation("SolicitudRecuperacionReemisor", fields: [reemitidaPorId], references: [id], onDelete: SetNull)
  @@index([estado, solicitadaEn])
  @@map("solicitudes_recuperacion")
}
model LimiteIntento {
  clave String @id
  intentos Int
  expiraEn DateTime
  @@index([expiraEn])
  @@map("limites_intentos")
}
