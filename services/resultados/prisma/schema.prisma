generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum EstadoEscrutinio {
  GENERADO
  PUBLICADO
}
model Escrutinio {
 id String @id @default(uuid()) @db.Uuid
 eleccionId String @unique @db.Uuid
 titulo String
 estado EstadoEscrutinio @default(GENERADO)
 totalVotos Int
 votosEnBlanco Int
 totalHabilitados Int
 participacion Decimal @db.Decimal(5,2)
 empate Boolean @default(false)
 empateResuelto Boolean @default(false)
 tipoEleccion String?
 pregunta String?
 snapshotJson Json? @db.JsonB
 hashCanonico String?
 hashPreDesempate String?
 hashVerificado String?
 generadoPor String? @db.Uuid
 publicadoPor String? @db.Uuid
 verificadoPor String? @db.Uuid
 verificadoEn DateTime?
 candidaturaDesempateId String? @db.Uuid
 desempatePor String? @db.Uuid
 desempateEn DateTime?
 motivoDesempate String?
 generadoEn DateTime @default(now())
 publicadoEn DateTime?
 candidaturas EscrutinioCandidatura[]
 grupos EscrutinioGrupo[]
 @@map("escrutinios")
}
model EscrutinioCandidatura {
 id String @id @default(uuid()) @db.Uuid
 escrutinioId String @db.Uuid
 candidaturaId String @db.Uuid
 nombre String
 votos Int
 porcentaje Decimal @db.Decimal(5,2)
 ganadora Boolean @default(false)
 orden Int @default(0)
 escrutinio Escrutinio @relation(fields: [escrutinioId], references: [id], onDelete: Cascade)
 @@map("escrutinios_candidaturas")
}
model EscrutinioGrupo {
 id String @id @default(uuid()) @db.Uuid
 escrutinioId String @db.Uuid
 facultad String
 carrera String
 votaron Int
 habilitados Int
 escrutinio Escrutinio @relation(fields: [escrutinioId], references: [id], onDelete: Cascade)
 @@map("escrutinios_grupos")
}
